#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
sem_t empty, full, mutex;
int buffer[5], count = 0;
void *producer(void *arg) {
    for (int i = 1; i <= 5; i++) {
        sem_wait(&empty);
        sem_wait(&mutex);
        buffer[count++] = i;
        printf("Producer produced item %d\n", i);
        sem_post(&mutex);
        sem_post(&full);
    }
    return NULL;
}
void *consumer(void *arg) {
    for (int i = 1; i <= 5; i++) {
        sem_wait(&full);
        sem_wait(&mutex);
        printf("Consumer consumed item %d\n", buffer[--count]);
        sem_post(&mutex);
        sem_post(&empty);
    }
    return NULL;
}
int main() {
    pthread_t p, c;
    sem_init(&empty, 0, 5);
    sem_init(&full, 0, 0);
    sem_init(&mutex, 0, 1);
    pthread_create(&p, NULL, producer, NULL);
    pthread_create(&c, NULL, consumer, NULL);
    pthread_join(p, NULL);
    pthread_join(c, NULL);
    return 0;
}
